<UserControl
    x:Class="Aether.WinUI.Controls.UpdateStatusPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Aether.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AccentFillColorDefaultBrush}" 
          Padding="12,4" 
          CornerRadius="14" 
          Margin="0,0,12,0"
          Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}">
        
        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="White"/>
            <TextBlock Text="{x:Bind ViewModel.UpdateVersion, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Update Available: {0}'}" 
                       Foreground="White"
                       FontSize="12" 
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>

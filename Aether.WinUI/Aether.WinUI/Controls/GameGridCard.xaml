<UserControl
    x:Class="Aether.WinUI.Controls.GameGridCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Aether.WinUI.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <MenuFlyout x:Key="GameContextMenu">
            <MenuFlyoutItem Text="Play" Icon="Play" Tag="Launch" Click="MenuFlyoutItem_Click"/>
            <MenuFlyoutItem Text="Stop" Icon="Stop" Tag="Stop" Click="MenuFlyoutItem_Click"/>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Add to Favorites" Icon="OutlineStar" Tag="Favorite" Click="MenuFlyoutItem_Click"/>
            <MenuFlyoutItem Text="Properties" Icon="Setting" Tag="Properties" Click="MenuFlyoutItem_Click"/>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid Width="200" Height="300" 
          CornerRadius="8" 
          ContextFlyout="{StaticResource GameContextMenu}">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cover Image -->
        <Border CornerRadius="8" Background="#20FFFFFF">
            <Image x:Name="CoverImage" Stretch="UniformToFill"/>
        </Border>

        <!-- Hover Overlay / State Overlay -->
        <Border CornerRadius="8" Background="#40000000" 
                Visibility="{x:Bind Game.State, Mode=OneWay, Converter={StaticResource GameStateToVisibilityConverter}, ConverterParameter='Active'}">
            <ProgressRing IsActive="True" Foreground="White" Width="40" Height="40" 
                          Visibility="{x:Bind Game.State, Mode=OneWay, Converter={StaticResource GameStateToBoolConverter}}"/>
        </Border>

        <!-- Gradient Overlay at bottom -->
        <Border VerticalAlignment="Bottom" Height="80" CornerRadius="0,0,8,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#80000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Title -->
        <TextBlock Text="{x:Bind Game.Title}" 
                   VerticalAlignment="Bottom" 
                   Margin="12" 
                   Foreground="White" 
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>

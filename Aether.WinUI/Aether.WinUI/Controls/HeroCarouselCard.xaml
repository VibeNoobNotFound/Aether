<UserControl
    x:Class="Aether.WinUI.Controls.HeroCarouselCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:attached="using:Aether.WinUI.AttachedProperties"
    mc:Ignorable="d">

    <Grid CornerRadius="12" Margin="4,0">
        <Image x:Name="HeroImage" Stretch="UniformToFill"
               attached:ImageCache.Source="{x:Bind Game.DisplayBackgroundImageUrl, Mode=OneWay}"/>
        
        <!-- Gradient Overlay -->
        <Border VerticalAlignment="Bottom" Height="140">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,24" Spacing="12">
            <Image x:Name="LogoImage" 
                   attached:ImageCache.Source="{x:Bind Game.LogoImageUrl, Mode=OneWay}"
                   MaxHeight="80"
                   HorizontalAlignment="Left"
                   Visibility="{x:Bind Game.HasLogo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock x:Name="TitleText" Text="{x:Bind Game.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" Foreground="White"
                       Visibility="{x:Bind Game.HasLogo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>

            <!-- Play / Stop / Launching -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Play Now"
                        Command="{x:Bind ViewModel.LaunchGameCommand, Mode=OneWay}"
                        CommandParameter="{x:Bind Game.Id, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind Game.State, Mode=OneWay, Converter={StaticResource GameStateToVisibilityConverter}, ConverterParameter=Stopped}"/>

                <Button Content="Stop"
                        Command="{x:Bind ViewModel.StopGameCommand, Mode=OneWay}"
                        CommandParameter="{x:Bind Game.Id, Mode=OneWay}"
                        Background="#FFB00020"
                        Foreground="White"
                        Visibility="{x:Bind Game.State, Mode=OneWay, Converter={StaticResource GameStateToVisibilityConverter}, ConverterParameter=Running}"/>

                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind Game.State, Mode=OneWay, Converter={StaticResource GameStateToVisibilityConverter}, ConverterParameter=Launching}">
                    <ProgressRing IsActive="True" Width="18" Height="18"/>
                    <TextBlock Text="Launching..." Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

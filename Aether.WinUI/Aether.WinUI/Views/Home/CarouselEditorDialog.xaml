<ContentDialog
    x:Class="Aether.WinUI.Views.Home.CarouselEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Aether.WinUI.Models"
    mc:Ignorable="d"
    Title="Configure Carousel"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel Spacing="16" MinWidth="400">
        <!-- Source Selection -->
        <ComboBox x:Name="SourceComboBox" Header="Content Source" 
                  SelectionChanged="SourceComboBox_SelectionChanged" 
                  HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Auto (Favorites + Recent)" Tag="0"/>
            <ComboBoxItem Content="From Collection" Tag="1"/>
            <ComboBoxItem Content="Manual Selection" Tag="2"/>
        </ComboBox>

        <!-- Collection Selection -->
        <StackPanel x:Name="CollectionPanel" Visibility="Collapsed" Spacing="8">
            <ComboBox x:Name="CollectionComboBox" Header="Collection" 
                      ItemsSource="{x:Bind ViewModel.Collections, Mode=OneWay}"
                      DisplayMemberPath="Name" 
                      HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Manual Selection -->
        <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Spacing="8">
             <TextBlock Text="Select Games" Style="{StaticResource BodyStrongTextBlockStyle}"/>
             <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                 <ListView x:Name="GamesListView" Height="300" SelectionMode="Multiple"
                           ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}">
                     <ListView.ItemTemplate>
                         <DataTemplate x:DataType="models:GameViewModel">
                             <TextBlock Text="{x:Bind Title}" Margin="0,4"/>
                         </DataTemplate>
                     </ListView.ItemTemplate>
                 </ListView>
             </Border>
        </StackPanel>
        
        <!-- Settings -->
        <NumberBox x:Name="MaxGamesBox" Header="Max Games" Value="5" Minimum="3" Maximum="20" SpinButtonPlacementMode="Inline"/>
    </StackPanel>
</ContentDialog>

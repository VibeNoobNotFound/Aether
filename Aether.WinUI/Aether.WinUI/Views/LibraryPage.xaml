<Page
    x:Class="Aether.WinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Aether.WinUI.Controls"
    xmlns:data="using:Aether.WinUI.Models"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <CommandBar Grid.Row="0" VerticalAlignment="Top" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right" Margin="0,10,20,0">
            <CommandBar.Content>
                <TextBlock Text="Library" Style="{StaticResource SubtitleTextBlockStyle}" Margin="24,12,0,0" Opacity="0.8"/>
            </CommandBar.Content>
            <AppBarButton Icon="Add" Label="Add Game">
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="AddGameMenu" Opening="AddGameMenu_Opening">
                        <MenuFlyoutItem Text="Scan Library" Icon="Refresh" Command="{x:Bind ViewModel.ScanLibraryCommand}"/>
                        <MenuFlyoutSeparator/>
                        <!-- Plugins added in code-behind -->
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.RefreshLibraryCommand}"/>
        </CommandBar>

        <!-- Empty State -->
        <Grid Grid.Row="1" 
              Visibility="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Center" 
              VerticalAlignment="Center">
            <StackPanel Spacing="20" HorizontalAlignment="Center" MaxWidth="400">
                <FontIcon Glyph="&#xE7FC;" FontSize="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                
                <TextBlock Text="No Games Found" 
                           Style="{StaticResource TitleTextBlockStyle}" 
                           HorizontalAlignment="Center"/>
                
                <TextBlock Text="Scan your library to find games from Steam, Epic, and more." 
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                
                <Button Content="Scan Library" 
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ScanLibraryCommand}"
                        HorizontalAlignment="Center"
                        Padding="24,12"/>
            </StackPanel>
        </Grid>

        <!-- Game Grid -->
        <GridView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Visibility="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='Inverse'}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="data:GameViewModel">
                    <controls:GameGridCard x:Name="Gamegcard" Click="Gamegcard_Click" Game="{x:Bind Mode=OneWay}" Margin="0,0,12,12"/>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

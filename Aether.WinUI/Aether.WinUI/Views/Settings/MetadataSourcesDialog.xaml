<ContentDialog
    x:Class="Aether.WinUI.Views.Settings.MetadataSourcesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Metadata Providers"
    PrimaryButtonText="Apply Changes"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <Grid Width="500" Height="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Drag to reorder. Aether will check providers in this order." 
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ListView x:Name="ProvidersList"
                  Grid.Row="1"
                  ItemsSource="{x:Bind Providers, Mode=OneWay}"
                  CanReorderItems="True"
                  AllowDrop="True"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid Height="44" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE700;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <FontIcon Grid.Column="1" Glyph="&#xE7FC;" Margin="12,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind}" VerticalAlignment="Center"/>

                        <Border Grid.Column="3"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10"
                                Padding="6,2"
                                Visibility="{x:Bind Converter={StaticResource StringEqualsConverter}, ConverterParameter=Steam}">
                            <TextBlock Text="Recommended" Foreground="White" FontSize="10"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>

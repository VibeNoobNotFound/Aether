<ContentDialog
    x:Class="Aether.WinUI.Views.Settings.PluginSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Plugin Settings"
    PrimaryButtonText="Close"
    DefaultButton="Primary">

    <Grid MinWidth="500" MinHeight="400">
        <StackPanel Spacing="16">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Visibility="Collapsed"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel" Spacing="16" Padding="4"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</ContentDialog>

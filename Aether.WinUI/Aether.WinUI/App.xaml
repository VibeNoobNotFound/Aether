<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Aether.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aether.WinUI"
    xmlns:converters="using:Aether.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            
            <converters:ConnectionStateToVisibilityConverter x:Key="ConnectionStateToVisibilityConverter" />
            <converters:ConnectionStateToBoolConverter x:Key="ConnectionStateToBoolConverter" />
            <converters:ErrorStateToVisibilityConverter x:Key="ErrorStateToVisibilityConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:GameStateToVisibilityConverter x:Key="GameStateToVisibilityConverter" />
            <converters:GameStateToBoolConverter x:Key="GameStateToBoolConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:PlatformToColorConverter x:Key="PlatformToColorConverter" />
            <converters:IconNameToGlyphConverter x:Key="IconNameToGlyphConverter" />
            <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
            <ThemeShadow x:Key="SharedShadow" />
            
            <!-- Custom Acrylic Brushes -->
            <AcrylicBrush x:Key="DarkAcrylicBackgroundBrush"
                          TintColor="#000000"
                          TintOpacity="0"
                          TintLuminosityOpacity="0.6" />
            <AcrylicBrush x:Key="DarkLightAcrylicBackgroundBrush"
            TintOpacity="0.2" TintLuminosityOpacity="0.6" TintColor="Black" FallbackColor="DarkGray" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

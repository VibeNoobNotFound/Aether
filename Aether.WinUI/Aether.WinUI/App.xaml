<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Aether.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aether.WinUI"
    xmlns:converters="using:Aether.WinUI.Converters" xmlns:ui="using:Microsoft.UI.Xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls">
                    <XamlControlsResources.MergedDictionaries>
                        <ui:ResourceDictionary>
                            <x:Double x:Key="ContentDialogMaxWidth">1600</x:Double>
                            <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
                        </ui:ResourceDictionary>
                    </XamlControlsResources.MergedDictionaries>
                </XamlControlsResources>
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            
            <converters:ConnectionStateToVisibilityConverter x:Key="ConnectionStateToVisibilityConverter" />
            <converters:ConnectionStateToBoolConverter x:Key="ConnectionStateToBoolConverter" />
            <converters:ErrorStateToVisibilityConverter x:Key="ErrorStateToVisibilityConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:GameStateToVisibilityConverter x:Key="GameStateToVisibilityConverter" />
            <converters:GameStateToBoolConverter x:Key="GameStateToBoolConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:PlatformToColorConverter x:Key="PlatformToColorConverter" />
            <converters:IconNameToGlyphConverter x:Key="IconNameToGlyphConverter" />
            <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
            <converters:ScoreToBrushConverter x:Key="ScoreToBrushConverter" />
            <converters:BoolToYesNoConverter x:Key="BoolToYesNoConverter" />
            <ThemeShadow x:Key="SharedShadow" />
            
            <AcrylicBrush x:Key="DarkAcrylicBackgroundBrush"
            TintOpacity="0.2" TintLuminosityOpacity="0.6" TintColor="Black" FallbackColor="Black" />

        </ResourceDictionary>
    </Application.Resources>
</Application>

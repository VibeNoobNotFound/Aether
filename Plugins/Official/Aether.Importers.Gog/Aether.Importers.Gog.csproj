<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Aether.PluginSDK\Aether.PluginSDK.csproj" />
  </ItemGroup>

  <ItemGroup>    
    <PackageReference Include="System.Text.Json" Version="10.0.1" />
  </ItemGroup>

  <Target Name="CopyPluginToBackend" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="../../../Aether.Backend/bin/$(Configuration)/$(TargetFramework)/plugins" />
  </Target>

</Project>

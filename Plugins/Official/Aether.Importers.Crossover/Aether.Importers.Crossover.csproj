<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Aether.PluginSDK\Aether.PluginSDK.csproj" />
  </ItemGroup>

  <Target Name="CopyPluginToBackend" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="../../../Aether.Backend/bin/$(Configuration)/$(TargetFramework)/plugins" />
  </Target>

</Project>
